# Obligatoria en producción: firma la cookie de sesión.
PYME_CLAVE_SECRETA="cambia-esto-por-una-clave-larga-y-aleatoria"
PYME_PRODUCCION="false"
PYME_NOMBRE_EMPRESA="Remodelaciones Demo"
PYME_ZONA_HORARIA="America/Santiago"
PYME_HORAS_PRIMER_SEGUIMIENTO="48"
# "memoria" captura los correos en la base (demo); "smtp" envía de verdad.
PYME_CORREO_MODO="memoria"
PYME_SMTP_HOST="smtp.example.com"
PYME_SMTP_PUERTO="587"
PYME_SMTP_USUARIO=""
PYME_SMTP_CLAVE=""
PYME_SMTP_TLS="true"
PYME_CORREO_REMITENTE="no-responder@example.com"
